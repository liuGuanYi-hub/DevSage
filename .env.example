# 仅供本地开发参考，不要填写真实密码、Token 或第三方密钥后提交。
POSTGRES_DB=devsage
POSTGRES_USER=devsage
POSTGRES_PASSWORD=change-me-before-start
DATABASE_URL=postgresql://devsage:change-me-before-start@db:5432/devsage
DEVSAGE_STORAGE=memory
DEVSAGE_CACHE=memory
DEVSAGE_REDIS_URL=redis://redis:6379/0
DEVSAGE_REDIS_TIMEOUT=2
DEVSAGE_AUTH_ENABLED=false
DEVSAGE_AUTH_SECRET=replace-with-at-least-32-random-characters
DEVSAGE_AUTH_USERS_FILE=config/auth-users.json
DEVSAGE_AUTH_TOKEN_TTL=3600
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_URL=
EMBEDDING_API_KEY_ENV=EMBEDDING_API_KEY
EMBEDDING_TIMEOUT=30
EMBEDDING_BATCH_SIZE=64
EMBEDDING_DIMENSION=1024
# 可选 GitHub-compatible 外部 Issue 只读查询；留空时使用 sample-data/issues/issues.json。
DEVSAGE_EXTERNAL_ISSUE_URL=
DEVSAGE_EXTERNAL_ISSUE_REPOSITORY=
DEVSAGE_EXTERNAL_ISSUE_TOKEN_ENV=GITHUB_TOKEN
DEVSAGE_EXTERNAL_ISSUE_TIMEOUT=10
DEVSAGE_EXTERNAL_ISSUE_WRITE_ENABLED=false
