# 仅供本地开发参考，不要填写真实密码、Token 或第三方密钥后提交。
POSTGRES_DB=devsage
POSTGRES_USER=devsage
POSTGRES_PASSWORD=change-me-before-start
DATABASE_URL=postgresql://devsage:change-me-before-start@db:5432/devsage
# 宿主机运行本地 E5 PostgreSQL smoke 时使用发布端口；不要提交真实密码。
HOST_DATABASE_URL=postgresql://devsage:change-me-before-start@127.0.0.1:5433/devsage
DEVSAGE_STORAGE=memory
DEVSAGE_CACHE=memory
DEVSAGE_REDIS_URL=redis://redis:6379/0
DEVSAGE_REDIS_TIMEOUT=2
DEVSAGE_AUTH_ENABLED=false
DEVSAGE_AUTH_SECRET=replace-with-at-least-32-random-characters
DEVSAGE_AUTH_USERS_FILE=config/auth-users.json
DEVSAGE_AUTH_TOKEN_TTL=3600
# 可选：注册一个外部 Obsidian Vault，只读读取；不会在 Vault 内写入任何文件。
DEVSAGE_OBSIDIAN_VAULT_PATH=
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_URL=
EMBEDDING_API_KEY_ENV=EMBEDDING_API_KEY
EMBEDDING_TIMEOUT=30
EMBEDDING_BATCH_SIZE=64
EMBEDDING_DIMENSION=1024
# 可选本地 E5 ONNX 配置；模型文件应放在项目 data/，不要提交模型。
LOCAL_EMBEDDING_MODEL=data/manual-models/multilingual-e5-large-qint8
LOCAL_EMBEDDING_BACKEND=onnx
LOCAL_EMBEDDING_FILE_NAME=model_qint8_avx512_vnni.onnx
LOCAL_EMBEDDING_CACHE=data/models

# Docker Backend 使用本地 E5 时，将上面的 EMBEDDING_PROVIDER 改为 local，
# 并确认项目 data/manual-models 下存在模型目录；模型通过只读 volume 挂载。
# INSTALL_LOCAL_EMBEDDING=true
# EMBEDDING_PROVIDER=local
# LOCAL_EMBEDDING_MODEL=/models/multilingual-e5-large-qint8
# LOCAL_EMBEDDING_BACKEND=onnx
# LOCAL_EMBEDDING_FILE_NAME=model_qint8_avx512_vnni.onnx
# LOCAL_EMBEDDING_CACHE=/models/cache
# GPU Docker 模式（确认 NVIDIA 驱动与 Docker nvidia runtime 可用后启用）：
# LOCAL_EMBEDDING_RUNTIME=gpu
# DOCKER_GPUS=all
# LOCAL_EMBEDDING_EXECUTION_PROVIDER=CUDAExecutionProvider
# 可选 GitHub-compatible 外部 Issue 只读查询；留空时使用 sample-data/issues/issues.json。
DEVSAGE_EXTERNAL_ISSUE_URL=
DEVSAGE_EXTERNAL_ISSUE_REPOSITORY=
DEVSAGE_EXTERNAL_ISSUE_TOKEN_ENV=GITHUB_TOKEN
DEVSAGE_EXTERNAL_ISSUE_TIMEOUT=10
DEVSAGE_EXTERNAL_ISSUE_WRITE_ENABLED=false
